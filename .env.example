# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno. Copia este archivo a .env.local para desarrollo y
# configúralas en Netlify (Site configuration → Environment variables).
# Nunca subas valores reales al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública del sitio (sin diagonal final). Se usa en los enlaces de los correos.
NEXT_PUBLIC_SITE_URL=https://tu-sitio.netlify.app

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave anónima/publicable. Es pública por diseño: la seguridad la dan las
# políticas RLS y las funciones de la base de datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (service_role / secret). SOLO servidor. Nunca en el
# navegador ni con el prefijo NEXT_PUBLIC_. Se usa únicamente para el
# procesador de notificaciones.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar los enlaces privados de gestión de citas.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MANAGE_LINK_SECRET=

# Secreto para anonimizar el origen de las solicitudes (límite de intentos).
# Genera otro distinto con el mismo comando.
CLIENT_KEY_SECRET=

# Secreto que protege el endpoint del procesador de notificaciones.
# Debe ser el mismo en la función programada de Netlify (usa la misma variable).
CRON_SECRET=

# Correo (opcional). Si se dejan vacías, no se envían correos: el paciente ve su
# confirmación en pantalla y Lulu puede avisar por WhatsApp desde el panel.
RESEND_API_KEY=
# Remitente verificado en Resend, ej.: Lulu Sevilla <citas@tudominio.com>
EMAIL_FROM=
